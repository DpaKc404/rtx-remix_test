-bool AssetReplacer::checkForChanges(const Rc<DxvkContext>& context) {
-  ScopedCpuProfileZone();
-
-  bool changed = false;
-  for (auto& mod : m_modManager.mods()) {
-    changed |= mod->checkForChanges(context);
-  }
-  if (changed) {
-    updateSecretReplacements();
-  }
-  return changed;
