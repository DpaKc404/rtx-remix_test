-    return;
-  }
-
-  // Handle resizing etc.. to match game window
-  switch(msg) {
-  case WM_ACTIVATE:
-  case WM_ACTIVATEAPP:
-  {
-    const bool becameActive = (wParam != 0);
-
-    // Foreground window guard to avoid hiding when the overlay takes focus
-    HWND fg = GetForegroundWindow();
-    DWORD fgPid = 0, gamePid = 0, ovlPid = 0;
