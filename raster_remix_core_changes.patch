-      }
-      break;
-    case FusedWorldViewMode::World:
-      if (Logger::logLevel() >= LogLevel::Warn) {
-        // Check if View is identity
-        ONCE_IF_FALSE(isIdentityExact(input.getTransformData().objectToView),
