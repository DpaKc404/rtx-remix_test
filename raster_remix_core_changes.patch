-  VkIndexType RtxGeometryUtils::getOptimalIndexFormat(uint32_t vertexCount) {
-    assert(vertexCount > 0);
-    return (vertexCount < 64 * 1024) ? VK_INDEX_TYPE_UINT16 : VK_INDEX_TYPE_UINT32;
-  }
