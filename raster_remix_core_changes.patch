-      [[fallthrough]];
-    case RtSurfaceMaterialType::Opaque:
-      m_opaqueSurfaceMaterial.writeGPUData(data, offset);
-      break;
-    case RtSurfaceMaterialType::Translucent:
-      m_translucentSurfaceMaterial.writeGPUData(data, offset, surfaceIndex);
