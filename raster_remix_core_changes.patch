-  const dxvk::Matrix4& objectToView, // Object to viewspace transform matrix
-  const bool isInfFrustum) {         // Is the camera frustum has infinity far plane
-
-  ScopedCpuProfileZone();
-
-  dxvk::RtFrustum& frustum = camera.getFrustum();
