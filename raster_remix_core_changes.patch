-  case WM_REMIX_HIDE_OVERLAY:
-    hide();
-    return 0;
-  case WM_DESTROY:
-    PostQuitMessage(0);
-    return 0;
-  }
-
-  if (ImGui_ImplWin32_WndProcHandler(m_hwnd, msg, wParam, lParam)) {
