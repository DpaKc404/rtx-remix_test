-    BasicType* getValuePtr(RtxOptionImpl::ValueType type) const {
-      GenericValue* genericValue = getGenericValuePtr(type);
-      return genericValue ? reinterpret_cast<BasicType*>(genericValue) : nullptr;
-    }
