-  void sanitizeData() {                                                                              \
-    constexpr Ranges ranges = {};                                                                    \
-    X_CONSTANTS(WRITE_CONSTANT_SANITIZATION)                                                         \
-    /* This matches the behavior of materials in toolkit */                                          \
-    if (m_dirty.test(DirtyFlags::k_EnableEmission)) {                                                \
