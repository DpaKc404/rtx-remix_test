-        info.m_interfaceInputs = T::getInterfaceInputSlots();
-        info.m_interfaceOutputs = T::getInterfaceOutputSlots();
-
-        Rc<DxvkShader> shader = createShader(info);
-        info.m_shader.push_back(shader);
