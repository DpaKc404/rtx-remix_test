-  Vector3 LightData::calculateRadiance() const {
-    Vector3 temperature(1.f);
-    if (m_EnableColorTemp) {
-      const pxr::GfVec3f vec = pxr::UsdLuxBlackbodyTemperatureAsRgb(m_ColorTemp);
