-        sphereLight.coneAngleDegrees = std::acos(shaping.getCosConeAngle()) * kRadiansToDegrees;
-        sphereLight.coneSoftness = shaping.getConeSoftness();
-        sphereLight.focusExponent = shaping.getFocusExponent();
