-
-    if (RtxOptions::graphicsPreset() == GraphicsPreset::Auto) {
-      const DxvkDeviceInfo& deviceInfo = device->adapter()->devicePropertiesExt();
-      const uint32_t vendorID = deviceInfo.core.properties.vendorID;
