-  void setIgnoreAlphaChannel(const bool ignoreAlphaChannel) {                                        \
-    m_ignoreAlphaChannelOverride = ignoreAlphaChannel;                                               \
-  }                                                                                                  \
-                                                                                                     \
-  const bool getIgnoreAlphaChannel() const {                                                         \
-    return m_ignoreAlphaChannelOverride;                                                             \
-  }                                                                                                  \
