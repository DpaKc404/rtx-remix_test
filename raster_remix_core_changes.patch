-  DebugViewArgs DebugView::getCommonDebugViewArgs(
-    RtxContext& ctx,
-    const Resources::RaytracingOutput& rtOutput,
-    DxvkObjects& common) {
-    const VkExtent3D debugViewResolution = m_debugView.view->imageInfo().extent;    
