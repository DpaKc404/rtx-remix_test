-    const Resources::RaytracingOutput& rtOutput) {
-    ScopedGpuProfileZone(ctx, "Gbuffer Raytracing");
-    ctx->setFramePassStage(RtxFramePassStage::GBufferPrimaryRays);
-
-    // Bind resources
-
-    ctx->bindCommonRayTracingResources(rtOutput);
