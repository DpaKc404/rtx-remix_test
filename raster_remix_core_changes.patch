-    prepExportMetaData(cap, framesPerSecond, exportPrep);
-    prepExportMaterials(cap, exportPrep);
-    prepExportMeshes(cap, exportPrep);
-    if (exportPrep.bExportInstanceStage) {
-      prepExportInstances(cap, exportPrep);
