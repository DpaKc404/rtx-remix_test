-      [[fallthrough]];
-    case RtSurfaceMaterialType::Opaque:
-      new (&m_opaqueSurfaceMaterial) RtOpaqueSurfaceMaterial{ surfaceMaterial.m_opaqueSurfaceMaterial };
-      break;
-    case RtSurfaceMaterialType::Translucent:
