-        m_shaderMapLock.lock();
-        pShaderPair = m_shaderMap.find(shaderName);
-        if (pShaderPair == m_shaderMap.end()) {
-          m_shaderMap[shaderName] = info;
-        }
-
-        m_shaderMapLock.unlock();
-        return info.m_shader.back();
-      } else {
