-    if (currentInstance == nullptr) {
-      // No existing match - so need to create one
-      currentInstance = addInstance(blas);
-    }
-
-    updateInstance(*currentInstance, cameraManager, blas, drawCall, materialData);
-   
-    return currentInstance;
-  }
