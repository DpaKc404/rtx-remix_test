-  void ManagedTexture::requestMips(uint32_t requiredMips) {
-    static_assert(MAX_MIPS <= std::numeric_limits<decltype(m_requestedMips)::value_type>::max());
-    assert(requiredMips <= MAX_MIPS);
-
-    if (!canDemote) {
-      requiredMips = MAX_MIPS;
