-      if (bucket->usesUnorderedApproximations && RtxOptions::enableSeparateUnorderedApproximations()) {
-        m_mergedInstances[Tlas::Unordered].push_back(instance);
-      } else {
-        m_mergedInstances[Tlas::Opaque].push_back(instance);
-      }
-    }
-  }
